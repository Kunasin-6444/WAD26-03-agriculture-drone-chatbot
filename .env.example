# LINE Bot Credentials
LINE_CHANNEL_ID=your_line_channel_id
LINE_CHANNEL_SECRET=your_line_channel_secret
LINE_CHANNEL_ACCESS_TOKEN=your_line_channel_access_token

# Release profile: Gemini primary requested by the owner on 2026-11-01.
# KKU gateway only for primary generation; do not enable paid services.
API_KEY=your_kku_genai_api_key
LLM_BASE_URL=https://gen.ai.kku.ac.th/api/v1
# Comma-separated; empty = no fallbacks. KKU model names don't exist on OpenAI.
LLM_FALLBACK_MODELS=claude-sonnet-5.5,gemini-3.7-flash,deepseek-v4-pro
# Thinking budget for reasoning models (none|minimal|low|medium|high); unset = provider default.
LLM_REASONING_EFFORT=low
LLM_MAX_OUTPUT_TOKENS=6000
# Enforce the answer JSON schema server-side (fixes models that rename the "quote" key).
# Needs a provider that supports response_format json_schema (Gemini OpenAI endpoint does).
# LLM_STRUCTURED_OUTPUT=true
# Optional second provider for 401/429, timeout/connection errors and 5xx failures.
# Quota rejections are refunded. Timeouts consume the attempt budget and trigger
# a cooldown so the next stage can use the configured secondary within its deadline.
# Example: primary = KKU gateway (above), secondary = Gemini's OpenAI-compatible endpoint.
# LLM_SECONDARY_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
# LLM_SECONDARY_API_KEY=your-gemini-key
LLM_SECONDARY_MODELS=gemini-3.5-flash-lite,gemini-3.1-flash-lite
LLM_SECONDARY_ORDER=last
# LLM_SECONDARY_REASONING_EFFORT=low
# Enable only after checking the secondary provider supports JSON Schema.
# LLM_SECONDARY_STRUCTURED_OUTPUT=true

# Google Gemini API Key (for embeddings & vision)
GOOGLE_API_KEY=your_google_api_key
# Native/table extraction is local; meaningful visual pages use this bounded API call.
VISION_MODEL=gemini-3.5-flash-lite
VISION_TIMEOUT_SECONDS=30
VISION_MAX_OUTPUT_TOKENS=16384

# Tavily API Key (for web fallback in Phase 2)
TAVILY_API_KEY=your_tavily_api_key
WEB_SEARCH_TIMEOUT_SECONDS=6
# Additional verified official domains, comma-separated hostnames (no URLs).
# WEB_ALLOWED_DOMAINS_EXTRA=
# Empty uses the official CAAT document URLs bundled in app/rag/source_policy.py.
CAAT_DESIGNATED_URLS=

# Online RAG: bounded requests; change model only after measuring quality/latency
ANSWER_MODE=natural
RAG_MODEL=gemini-3.7-flash
RAG_REQUEST_TIMEOUT_SECONDS=50
RETRIEVER_BM25=global
RETRIEVER_RERANK=diverse
RETRIEVER_TABLE_CONTINUATION=2
RETRIEVER_PHRASE_WEIGHT=0.2
# Each question is independent; conversation topic carryover is disabled in the app.
# Optional isolated database path for local development/test runs
# CHROMA_PATH=chroma_db

# PDF retrieval: text (existing hybrid index) or direct (separate PDF page index).
# Current deployment restores the existing text index; no automatic ingestion.
# Switch only after comparing retrieval quality; restart the app after editing.
PDF_RETRIEVAL_MODE=text
# Direct mode reads only retrieved PDF pages, then caches transcripts for citations.
PDF_READER_MODEL=gemini-3.5-flash-lite
PDF_READ_MAX_PAGES=3
# Gemini generation requires a request timeout of at least 10 seconds.
PDF_READ_TIMEOUT_SECONDS=10

# Current measured profile (seconds); KB_GENERATION applies to the legacy grounded mode.
LLM_ATTEMPT_TIMEOUT_SECONDS=35
KB_GENERATION_BUDGET_SECONDS=25

# Build the retrieval index at startup so the first message is not ~4s slower (default true).
# WARMUP_ON_STARTUP=true

# Durable single-host LINE inbox. Persist/backup this file together with the app data.
LINE_INBOX_DB_PATH=cache/line_inbox.sqlite3
LINE_INBOX_LEASE_SECONDS=120
LINE_INBOX_MAX_ATTEMPTS=4
LINE_WORKER_CONCURRENCY=3

# Optional deployment revision: change when publishing a new knowledge index.
# KB_REVISION=2026-10-17-v1
