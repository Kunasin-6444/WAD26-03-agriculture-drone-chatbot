# LINE Bot Credentials
LINE_CHANNEL_ID=your_line_channel_id
LINE_CHANNEL_SECRET=your_line_channel_secret
LINE_CHANNEL_ACCESS_TOKEN=your_line_channel_access_token

# LLM provider (OpenAI-compatible). Default is the KKU gateway using API_KEY.
# To use OpenAI instead, uncomment the block below (and set RAG_MODEL=gpt-4.1-mini).
API_KEY=your_kku_genai_api_key
# LLM_API_KEY=your_openai_api_key
# LLM_BASE_URL=https://api.openai.com/v1
# Comma-separated; empty = no fallbacks. KKU model names don't exist on OpenAI.
# LLM_FALLBACK_MODELS=
# Thinking budget for reasoning models (none|minimal|low|medium|high); unset = provider default.
# LLM_REASONING_EFFORT=low
# Enforce the answer JSON schema server-side (fixes models that rename the "quote" key).
# Needs a provider that supports response_format json_schema (Gemini OpenAI endpoint does).
# LLM_STRUCTURED_OUTPUT=true
# Optional second provider, used ONLY when the primary's models answer 401/429 (quota gone).
# Those errors return instantly, so failing over costs no request budget; timeouts do not fail over.
# Example: primary = KKU gateway (above), secondary = Gemini's OpenAI-compatible endpoint.
# LLM_SECONDARY_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
# LLM_SECONDARY_API_KEY=your-gemini-key
# LLM_SECONDARY_MODELS=gemini-3.5-flash-lite
# LLM_SECONDARY_REASONING_EFFORT=low

# Google Gemini API Key (for embeddings & vision)
GOOGLE_API_KEY=your_google_api_key

# Tavily API Key (for web fallback in Phase 2)
TAVILY_API_KEY=your_tavily_api_key

# Online RAG: bounded requests; change model only after measuring quality/latency
# gpt-5.6-luna and nova-2-lite-v1 hit their daily quota during 2026-10-15 testing;
# gemini-3.5-flash-lite is served by the same gateway and was already validated.
RAG_MODEL=gemini-3.5-flash-lite
RAG_REQUEST_TIMEOUT_SECONDS=22
# Optional isolated database path for local development/test runs
# CHROMA_PATH=chroma_db

# Timeouts (seconds). Defaults 8/8. If the provider's latency spikes cause false abstains, try 11/11
# (total request budget stays RAG_REQUEST_TIMEOUT_SECONDS).
# LLM_ATTEMPT_TIMEOUT_SECONDS=11
# KB_GENERATION_BUDGET_SECONDS=11

# Build the retrieval index at startup so the first message is not ~4s slower (default true).
# WARMUP_ON_STARTUP=true
